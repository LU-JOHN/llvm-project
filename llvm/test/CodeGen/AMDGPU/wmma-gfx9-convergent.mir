# RUN: llc -mtriple=amdgcn-amd-amdhsa -mcpu=gfx9-generic -run-pass=machine-sink -mattr=+wavefrontsize64 %s -stats 2>&1 | \
# RUN:   not grep "Number of machine instructions sunk"
# machine-sink must not sink WMMA* instructions.
# Ensure that WMMA instructions are marked as convergent to prevent
# machine-sink from sinking them.


---
name:            wmma_test_V_MFMA_F32_32X32X64_F8F6F4_f4_f4_e64
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)

    %vsrc0:av_128_align2 = IMPLICIT_DEF
    %ssrc:sreg_64 = IMPLICIT_DEF
    %vsrc2:areg_512 = IMPLICIT_DEF
    %vdst:areg_512 = nofpexcept V_MFMA_F32_32X32X64_F8F6F4_f4_f4_e64 %vsrc0, %vsrc0, %vsrc2, 0, 0, implicit $mode, implicit $exec
    %sdst:sreg_64 = SI_IF %ssrc, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...

---
name:            wmma_test_V_MFMA_SCALE_F32_32X32X64_F8F6F4_f4_f4_mac_vgprcd_e64
body:             |
  bb.0:
    successors: %bb.1(0x40000000), %bb.2(0x40000000)

    %vsrc0:av_128_align2 = IMPLICIT_DEF
    %ssrc:sreg_64 = IMPLICIT_DEF
    %vsrc2:vreg_512_align2 = IMPLICIT_DEF
    %scale_vsrc0:vgpr_32 = IMPLICIT_DEF
    %scale_vsrc2:vgpr_32 = IMPLICIT_DEF
    %vdst:vreg_512_align2 = nofpexcept V_MFMA_SCALE_F32_32X32X64_F8F6F4_f4_f4_mac_vgprcd_e64 %vsrc0, %vsrc0, %vsrc2, 4, 4, %scale_vsrc0, killed undef %scale_vsrc2, 0, 0, implicit $mode, implicit $exec
    %sdst:sreg_64 = SI_IF %ssrc, %bb.2, implicit-def dead $exec, implicit-def dead $scc, implicit $exec
    S_BRANCH %bb.1

  bb.1:
    successors: %bb.2(0x80000000)

    S_BRANCH %bb.2

  bb.2:
    S_ENDPGM 0
...
